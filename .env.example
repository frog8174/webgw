# -- Upstream crawl4ai --------------------------------------------------------
# 127.0.0.1 for local testing; change to a LAN address later, e.g.
# http://192.168.1.50:11235
CRAWL4AI_BASE_URL=http://127.0.0.1:11235
CRAWL4AI_TOKEN=changeme

# -- Gateway listener ---------------------------------------------------------
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080

# -- Selection budget ---------------------------------------------------------
# Measured on a 92k-token page: 4000 failed, 6000 failed, 8000 succeeded.
SELECT_BUDGET_TOKENS=8000
PASSTHROUGH_MAX_TOKENS=4000   # pages under this size are returned whole
# Largest share of the budget one section may take. At 0.5 a single section was
# measured consuming it on its own.
MAX_SECTION_FRAC=0.35

# -- Fetching -----------------------------------------------------------------
FETCH_TIMEOUT_S=30

# DNS rebinding protection. On a NodePort deployment, add <node-ip>:<port>:
#   MCP_ALLOWED_HOSTS=127.0.0.1,localhost,192.168.1.50:30080
# Set to * to disable (trusted networks only).
MCP_ALLOWED_HOSTS=127.0.0.1,localhost

# -- Cache --------------------------------------------------------------------
CACHE_PATH=/data/cache.sqlite3
CACHE_RETENTION_DAYS=14          # retention: past this the row is deleted
CACHE_DEFAULT_MAX_AGE_S=86400    # freshness: past this the page is re-fetched
                                 # (the row survives, so a failed re-fetch can
                                 #  still serve stale content)
# Per-domain freshness overrides, clamped by retention -- setting more than 14
# days here has no effect.
CACHE_DOMAIN_RULES=technews.tw=3600,www.ithome.com.tw=3600,docs.crawl4ai.com=604800
CACHE_MAX_BYTES=2147483648       # 2GB, LRU eviction beyond this
CACHE_CLEANUP_INTERVAL_S=3600

# -- Retrieval and reranking --------------------------------------------------
# Default retrieval mode: bm25 (about 2.5s) | rerank (about 5-8s)
RETRIEVAL_MODE=bm25
# Cross-encoder reranking service. Empty disables it, and mode=rerank then
# degrades automatically to bm25.
RERANKER_URL=
RERANKER_MODEL=bge-reranker-v2-m3   # vLLM's served-model-name
RERANK_TOP_N=30                     # candidates sent to rerank; never the whole page
RERANK_TIMEOUT_S=15
RERANK_DOC_CHARS=2000               # per-passage character cap before the model truncates
# API key for a commercial reranking service (Cohere, Jina, Voyage). Self-hosted
# vLLM does not need one -- leave it empty. These services share the request and
# response shape of a self-hosted endpoint and differ only in authentication.
RERANKER_API_KEY=

# -- Authentication -----------------------------------------------------------
# The MCP specification says servers SHOULD authenticate all connections.
# Empty disables it, and the gateway then binds 127.0.0.1 only -- it refuses to
# serve externally without a token.
WEBGW_AUTH_TOKEN=

# -- Limits -------------------------------------------------------------------
# Upstream crawl4ai applies no throttling of its own.
MAX_CONCURRENT_FETCHES=4     # concurrent fetches; anything beyond this queues
RATE_LIMIT_PER_MINUTE=60     # requests per minute, 0 = unlimited
