# ── 上游 crawl4ai ──────────────────────────────────────────────
# 本機測試用 127.0.0.1；之後改成區網位址,例如 http://192.168.1.50:11235
CRAWL4AI_BASE_URL=http://127.0.0.1:11235
CRAWL4AI_TOKEN=changeme

# ── gateway 監聽 ──────────────────────────────────────────────
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080

# ── 選節預算 (依實測:4000 tok 下 ground-truth 命中 12/12) ──────
SELECT_BUDGET_TOKENS=4000
PASSTHROUGH_MAX_TOKENS=4000
MAX_SECTION_FRAC=0.5

# ── 抓取 ──────────────────────────────────────────────────────
FETCH_TIMEOUT_S=30

# DNS rebinding 防護。走 NodePort 時要加入 <節點IP>:<port>,例如:
#   MCP_ALLOWED_HOSTS=127.0.0.1,localhost,192.168.1.50:30080
# 設為 * 可停用(僅限受信任區網)
MCP_ALLOWED_HOSTS=127.0.0.1,localhost

# ── 快取 ──────────────────────────────────────────────────────
CACHE_PATH=/data/cache.sqlite3
CACHE_RETENTION_DAYS=14          # 保留期:超過就刪除
CACHE_DEFAULT_MAX_AGE_S=86400    # 新鮮度:超過就重抓(資料還在,重抓失敗可回 stale)
# 逐網域新鮮度覆寫。會被保留期夾住 —— 設超過 14 天無效。
CACHE_DOMAIN_RULES=technews.tw=3600,www.ithome.com.tw=3600,docs.crawl4ai.com=604800
CACHE_MAX_BYTES=2147483648       # 2GB,LRU 淘汰
CACHE_CLEANUP_INTERVAL_S=3600

# ── 認證 (MCP 規格:伺服器 SHOULD 對所有連線實作認證) ────────────
# 空白 = 不啟用,且會強制只綁 127.0.0.1 (拒絕在無認證下對外開放)
WEBGW_AUTH_TOKEN=

# ── 限流 (上游 crawl4ai 自己沒有任何限流) ──────────────────────
MAX_CONCURRENT_FETCHES=4     # 同時進行的抓取上限,超過排隊
RATE_LIMIT_PER_MINUTE=60     # 每分鐘請求上限,0 = 不限
